{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Intake": {
    "StoragePath": "App_Data/invoices",
    "MaxUploadSizeBytes": 10485760
  },
  "Approval": {
    "Tiers": [
      {
        "UpToAmount": 100000,
        "RequiredApprovers": 1
      },
      {
        "UpToAmount": 1000000,
        "RequiredApprovers": 2
      }
    ],
    "AboveTopTierApprovers":  3
  }
}
